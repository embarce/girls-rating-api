# Server
APP_PORT=8080
APP_ENV=development

# 上传接口固定 API Key（维护脚本使用，通过 X-API-Key 请求头传递）
UPLOAD_API_KEY=your-upload-api-key-here

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=cat

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24
JWT_ISSUER=girls-rating-api

# Cloudflare R2 (S3 兼容)
R2_ACCOUNT_ID=id
R2_ACCESS_KEY=key
R2_SECRET_KEY=key
R2_BUCKET=image

# S3 公开访问 URL (用于拼接图片完整地址)
S3_HOST=https://image.com

# 随机池（v2：池成员为 PhotoRow JSON，含 rarity/authorId）
RANDOM_POOL_SIZE=20000
RANDOM_POOL_REFRESH_SECONDS=3600
RANDOM_POOL_LOCK_SECONDS=300
# RANDOM_POOL_SET_KEY=cache:random_pool:v2:set

# 照片定档（docs/design/photo-system.md §四，阈值与 002 迁移回填 SQL 同源）
PHOTO_SSR_MIN_RATING=9.0
PHOTO_SR_MIN_RATING=7.0
PHOTO_DEFAULT_AUTHOR_ID=1

# 抽卡（docs/design/gacha-system.md §四.3）
GACHA_DRAW_SIZE=10
GACHA_SSR_WEIGHT=6
GACHA_SR_WEIGHT=24
GACHA_R_WEIGHT=70
GACHA_TIMEZONE=Asia/Shanghai
GACHA_POOL_SIZE=500
GACHA_POOL_REFRESH_SECONDS=3600
GACHA_POOL_LOCK_SECONDS=300
# GACHA_POOL_SET_KEY_PREFIX=cache:gacha_pool:v2

# Cloudflare Turnstile 人机验证（保护 注册/登录/邮件反馈；留空 = 不启用，中间件直接放行）
TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Resend 邮件发送（用户反馈中继；RESEND_API_KEY 留空 = 未配置，反馈接口 503）
RESEND_API_KEY=
# 发件人，"Name <addr>" 或纯地址，需为 Resend 已验证域名
MAIL_FROM=Girls Rating <noreply@girls-rating.com>
# 反馈收件邮箱（支持团队收件箱）
MAIL_CONTACT_TO=support@girls-rating.com
