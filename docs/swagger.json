        "/api/v1/upload/image": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "上传图片文件到 Cloudflare R2，同时在数据库中创建图片资源记录。此接口使用固定 API Key 认证，供维护脚本调用。rarity 显式定档优先，缺省按 rating 阈值派生（\u003e=9 SSR / \u003e=7 SR）；作者优先级 author_id \u003e author_name(find-or-create) \u003e 默认作者",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "图片资源"
                ],
                "summary": "上传图片到 R2 并创建图片资源",
                "parameters": [
                    {
                        "type": "file",
                        "description": "图片文件 (JPEG/PNG/WebP/GIF)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "评分 (默认 4.0)",
                        "name": "rating",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "浏览量 (默认 '1k')",
                        "name": "views",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "作者 ID（无效值回退默认作者）",
                        "name": "author_id",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "作者名（find-or-create 兜底通道，优先级低于 author_id）",
                        "name": "author_name",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "作者头像外链（配合 author_name 创建时使用）",
                        "name": "author_avatar",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "卡片等级显式定档：0/1/2 或 R/SR/SSR（缺省按 rating 派生）",
                        "name": "rarity",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "宽度 (默认自动检测)",
                        "name": "width",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "高度 (默认自动检测)",
                        "name": "height",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "data: UploadImageResponseData",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "未授权：缺少或无效的 X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "禁止：未配置上传 API Key",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/user": {
            "get": {
                "security": [
