{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "基于 Go 构建的 RESTful API 服务，支持用户注册、登录、认证等功能",
        "title": "Girls Rating API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/cosplay": {
            "get": {
                "description": "按时间倒序分页返回图片资源列表（统一 PhotoResponse：rating 浮点、rarity 卡片等级、作者来自 authors 表）；author_id 传入时按作者过滤（作者专区）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "图片资源"
                ],
                "summary": "分页查询 Cosplay 图片资源",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码，从 1 开始",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页数量",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "作者 ID（authors.id，过滤该作者作品）",
                        "name": "author_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.CosplayListResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/gacha/collection": {
            "get": {
                "description": "全部快照按时间倒序展开，应用层切片分页；每张卡带 drawDate",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "抽卡"
                ],
                "summary": "卡册分页（按设备）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备标识",
                        "name": "X-Device-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码，从 1 开始",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 30,
                        "description": "每页数量",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { list, total, page, pageSize, stats }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "缺少 X-Device-Id",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/gacha/draw": {
            "post": {
                "description": "每台设备每天一次、固定 10 张；当天已抽时补发当日快照（replayed=true），不返回 409。请求头携带 X-Device-Id",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "抽卡"
                ],
                "summary": "每日抽卡（幂等补发）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备标识（前端 crypto.randomUUID() 生成并持久化）",
                        "name": "X-Device-Id",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { date, replayed, cards, stats }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "缺少 X-Device-Id",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误（池空/存储失败）",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/gacha/status": {
            "get": {
                "description": "前端开屏调用：drawnToday=false 且当日未弹过 → 每日弹窗；drawnToday=true → 抽卡页直接进展示态",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "抽卡"
                ],
                "summary": "抽卡状态（今日能否抽 + 公示概率 + 累计统计）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备标识",
                        "name": "X-Device-Id",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { date, drawnToday, cards, probabilities, stats, pool }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "缺少 X-Device-Id",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/latest": {
            "get": {
                "description": "按入档时间倒序返回最新一批图片（默认 10 张，limit 1-20），data 直接是数组、无分页包装，供入口页高斯模糊背景使用",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "图片资源"
                ],
                "summary": "入口页最新图片",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "数量，1-20",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.LatestResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/random": {
            "get": {
                "description": "随机返回图片资源列表（统一 PhotoResponse：rating 浮点、rarity 卡片等级、作者来自 authors 表），无需认证",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "图片资源"
                ],
                "summary": "获取随机图片资源",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.RandomAPIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/authors": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "name 精确匹配（命中返回单条，供爬虫先查后建）；keyword 模糊分页列表",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "作者列表（作者存在性检查入口）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "精确匹配作者名（存在性检查）",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "模糊匹配作者名",
                        "name": "keyword",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码，从 1 开始",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "每页数量",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { list: [Author], total }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权：缺少或无效的 X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "403": {
                        "description": "禁止：未配置 API Key",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "name 已存在时返回 200 + 既有记录 + existed:true；新建返回 201。爬虫崩溃重试不会产生重复",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "创建作者（幂等）",
                "parameters": [
                    {
                        "description": "作者信息",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.AdminAuthorCreateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { author, existed:true }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "201": {
                        "description": "data: { author, existed:false }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "403": {
                        "description": "禁止",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/authors/{id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "不存在或已软删返回 404",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "作者详情",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "作者 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { author }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "作者不存在",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "同事务把 name 改写为 \"{name}#del#{id}\" 释放唯一槽位，允许重建同名；响应带 affectedImages 计数",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "删除作者（软删除）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "作者 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { affectedImages }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "作者不存在",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "改名撞唯一索引返回 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "更新作者",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "作者 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "更新内容（nil 字段跳过）",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.AdminAuthorUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { author }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "作者不存在",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "409": {
                        "description": "名称冲突",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/authors/{id}/avatar": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "multipart 头像文件 → R2 avatars/ 前缀 → 更新 URL + 失效作者缓存",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-作者"
                ],
                "summary": "上传作者头像",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "作者 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "头像文件 (JPEG/PNG/WebP/GIF)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: { author }",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "作者不存在",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/images/{id}": {
            "patch": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "改 rating/rarity/views/author_id：重算定档落库、清分页缓存、同步随机池与抽卡池",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理端-图片"
                ],
                "summary": "修改图片资源（重算定档）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "图片 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "更新内容（nil 字段跳过）",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.AdminImageUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: PhotoResponse",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "图片不存在",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/login": {
            "post": {
                "description": "使用用户名和密码登录，返回 JWT token；服务端配置 TURNSTILE_SECRET_KEY 后需携带 X-Turnstile-Token（人机验证）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Turnstile 人机验证 token（启用时必填）",
                        "name": "X-Turnstile-Token",
                        "in": "header"
                    },
                    {
                        "description": "登录信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "用户名或密码错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "人机验证失败或缺 token",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/mail/contact": {
            "post": {
                "description": "将用户反馈转发到支持邮箱（MAIL_CONTACT_TO），Reply-To 指向用户邮箱。请求头携带 X-Turnstile-Token（服务端启用人机验证时必填）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "邮件"
                ],
                "summary": "用户反馈邮件（Resend 中继）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Turnstile 人机验证 token（启用时必填）",
                        "name": "X-Turnstile-Token",
                        "in": "header"
                    },
                    {
                        "description": "反馈内容",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.MailContactRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: {}",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "403": {
                        "description": "人机验证失败",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "502": {
                        "description": "Resend 上游错误",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "503": {
                        "description": "邮件未配置",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/register": {
            "post": {
                "description": "创建新用户账号；服务端配置 TURNSTILE_SECRET_KEY 后需携带 X-Turnstile-Token（人机验证）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "用户注册",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Turnstile 人机验证 token（启用时必填）",
                        "name": "X-Turnstile-Token",
                        "in": "header"
                    },
                    {
                        "description": "注册信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
